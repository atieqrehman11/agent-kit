                <mxCell id="c26" value="Only guidelines/, skills/, commands/ and agents/ are ever replaced. Everything else in the target is untouched — which is what makes it safe to install into the directory that already holds your own state." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#5A6672;fontFamily=Helvetica;" parent="c23" vertex="1">
                    <mxGeometry x="30" y="150" width="592" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c27" value="UNINSTALL" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#EEF0F2;strokeColor=#9AA5AF;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontColor=#333333;fontStyle=1;fontSize=13;fontFamily=Helvetica;container=1;collapsible=0;" parent="1" vertex="1">
                    <mxGeometry x="720" y="630" width="330" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="c28" value="Driven by the &lt;b&gt;receipt&lt;/b&gt;, not by re-scanning core/.&lt;br&gt;&lt;br&gt;So an artifact deleted from core/ since you installed is still removed, and a file you added by hand is still left alone.&lt;br&gt;&lt;br&gt;Directories are removed only once empty. The kit data dir is never removed." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#5A6672;fontFamily=Helvetica;" parent="c27" vertex="1">
