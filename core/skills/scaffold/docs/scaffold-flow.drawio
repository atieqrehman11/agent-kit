                <mxCell id="c13" value="Aspects applied&lt;br&gt;&lt;br&gt;cicd — pipeline + per-env config&lt;br&gt;api — health/info + service spine&lt;br&gt;standards — docs/ + conformance&lt;br&gt;gitignore · CONFIG.md&lt;br&gt;&lt;br&gt;An existing file is SKIPPED,&lt;br&gt;never overwritten" style="shape=mxgraph.flowchart.multi-document;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFC8D0;fontColor=#333333;fontSize=11;fontFamily=Helvetica;verticalAlign=middle;align=center;spacing=4;" parent="c10" vertex="1">
