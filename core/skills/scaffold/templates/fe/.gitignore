# ── Node ────────────────────────────────────────────────────────────────────
node_modules/
.npm/

# ── Build output ────────────────────────────────────────────────────────────
# dist/ IS committed. The Apps build environment cannot resolve
# registry.npmjs.org, so nothing can be installed or built there, and the
# controller deploys from a fresh clone. Rebuild and commit it whenever src/
# changes, or stg deploys green and serves a stale bundle.
.vite/
*.tsbuildinfo

# ── Test output ─────────────────────────────────────────────────────────────
coverage/

# ── Databricks Asset Bundles ────────────────────────────────────────────────
.databricks/

# ── Secrets / local config ──────────────────────────────────────────────────
# BACKEND_API_UPSTREAM / BACKEND_API_TOKEN for the Vite dev proxy live here.
.env
.env.*
*.local

# ── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
