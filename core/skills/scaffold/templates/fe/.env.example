# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# Only local development reads these. The deployed app takes its configuration
# from the bundle variables in databricks.yml, which resources/fe.app.yml turns
# into the App's env — nothing here reaches a workspace.

# The use case API to proxy to. Required in both dev and prod mode: in prod
# server.mjs exits without it, and in dev the proxy route is never registered, so
# every /api call 404s with no obvious cause.
BACKEND_API_UPSTREAM=https://<app-name>-<workspace-id>.aws.databricksapps.com

# A deployed Databricks App sits behind OAuth and answers 401 without a token.
# Generate one with:  databricks auth token --host <workspace-url>
# Leave unset when the upstream is a backend running on your own machine.
BACKEND_API_TOKEN=

# Override the port. Defaults: 5173 in dev mode, 8000 in prod mode.
# PORT=5173
